{
  "datasets": [
    {
      "name": "ds_kpi",
      "displayName": "Gateway KPIs (7d)",
      "queryLines": [
        "SELECT count(*) AS requests, count(DISTINCT requester) AS requesters,\n",
        "  sum(total_tokens) AS tokens, round(percentile(latency_ms, 0.95)) AS p95_latency_ms\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE event_time >= current_timestamp() - INTERVAL 7 DAYS AND (request_tags['lngdemo_project'] = 'lngdemo-ai-governance')\n"
      ]
    },
    {
      "name": "ds_requester",
      "displayName": "Requests by requester",
      "queryLines": [
        "SELECT requester, requester_type, service_name, count(*) AS requests,\n",
        "  sum(total_tokens) AS tokens, round(avg(latency_ms)) AS avg_latency_ms\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE event_time >= current_timestamp() - INTERVAL 7 DAYS AND (request_tags['lngdemo_project'] = 'lngdemo-ai-governance')\n",
        "GROUP BY ALL ORDER BY requests DESC\n"
      ]
    },
    {
      "name": "ds_hourly",
      "displayName": "Requests and latency per hour",
      "queryLines": [
        "SELECT date_trunc('HOUR', event_time) AS hour, service_name, count(*) AS requests,\n",
        "  round(percentile(latency_ms, 0.95)) AS p95_latency_ms\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE event_time >= current_timestamp() - INTERVAL 7 DAYS AND (request_tags['lngdemo_project'] = 'lngdemo-ai-governance')\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_tags",
      "displayName": "Requests by request tags",
      "queryLines": [
        "SELECT coalesce(request_tags['lngdemo_desk'], '(no lngdemo_desk tag)') AS desk,\n",
        "  coalesce(request_tags['lngdemo_use_case'], '(no lngdemo_use_case tag)') AS use_case, count(*) AS requests, sum(total_tokens) AS tokens\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE event_time >= current_timestamp() - INTERVAL 7 DAYS AND (request_tags['lngdemo_project'] = 'lngdemo-ai-governance')\n",
        "GROUP BY ALL ORDER BY requests DESC\n"
      ]
    },
    {
      "name": "ds_status",
      "displayName": "HTTP status codes",
      "queryLines": [
        "SELECT cast(status_code AS STRING) AS status_code, count(*) AS requests\n",
        "FROM system.ai_gateway.usage\n",
        "WHERE event_time >= current_timestamp() - INTERVAL 7 DAYS AND (request_tags['lngdemo_project'] = 'lngdemo-ai-governance')\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_policy",
      "displayName": "Policy outcomes (red-team runs)",
      "queryLines": [
        "SELECT module, outcome, count(*) AS calls\n",
        "FROM red_team_results GROUP BY ALL\n"
      ]
    },
    {
      "name": "ds_redteam",
      "displayName": "Latest red-team result per test",
      "queryLines": [
        "SELECT module, test_id, persona, expected, outcome, verdict, http_status, left(policy_json, 160) AS policy\n",
        "FROM red_team_results\n",
        "QUALIFY row_number() OVER (PARTITION BY test_id ORDER BY run_ts DESC) = 1\n",
        "ORDER BY module, test_id\n"
      ]
    },
    {
      "name": "ds_claims",
      "displayName": "Claim ledger",
      "queryLines": [
        "SELECT claim_id, status, claim, left(observed_result, 200) AS observed, tested_at FROM claim_ledger ORDER BY claim_id\n"
      ]
    }
  ],
